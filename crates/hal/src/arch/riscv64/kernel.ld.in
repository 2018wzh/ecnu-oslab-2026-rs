OUTPUT_ARCH(riscv)
ENTRY(_entry)
SECTIONS {
    . = @LOAD@;
    .text : { KEEP(*(.text.entry)) *(.text .text.*) }
    . = ALIGN(4096); text_end = .;
    .rodata : ALIGN(4096) { *(.rodata .rodata.*) }
    . = ALIGN(4096); rodata_end = .;
    .data : ALIGN(4096) { *(.sdata .sdata.* .data .data.*) }
    . = ALIGN(8);
    __bss_start = .;
    .bss : { *(.sbss .sbss.* .bss .bss.*) }
    . = ALIGN(8);
    __bss_end = .;
    .stacks (NOLOAD) : ALIGN(16) { KEEP(*(.stacks)) }
    . = ALIGN(4096);
    kernel_end = .;
    /DISCARD/ : { *(.eh_frame .comment) }
}
